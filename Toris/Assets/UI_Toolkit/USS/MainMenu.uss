/* --- Root Layout --- */
.main-menu-root {
    picking-mode: Ignore;
    flex-shrink: 0;
    flex-grow: 1;
    width: 100%;
    height: 100%;
    flex-direction: row;
    background-color: var(--color-bg-dark); /* Exact var from theme-variables.uss[cite: 17] */
}

/* --- Left Navigation Panel --- */
.main-menu-nav-panel {
    width: 350px;
    height: 100%;
    flex-shrink: 0; /* Prevents squishing by the right panel[cite: 19] */
    flex-direction: column;
    justify-content: center;
    padding: 20px;
    
    background-color: var(--color-bg-panel); /*[cite: 17] */
    border-right-width: 2px;
    border-right-color: var(--color-border-default); /*[cite: 17] */
}

.main-menu-title {
    font-size: var(--font-size-h1); /* Upgrading the font size specifically for the main menu[cite: 17] */
    -unity-text-align: middle-center;
    margin-bottom: 60px;
    white-space: normal;
    /* Color is natively handled by the .panel-title class inherited from Components.uss */
}

/* --- Buttons --- */
.main-menu-button-group {
    flex-direction: column;
    align-items: stretch;
}

.main-menu-button {
    height: 60px;
    margin-bottom: 15px;
    font-size: var(--font-size-h3); /*[cite: 17] */
    
    /* Background colors, borders, fonts, and hover animations 
       are all safely handled by .standard-button[cite: 18]. 
       We only define the specific sizing/spacing here. */
}

/* --- Navigation Button Hovers --- */
.btn-nav--play:hover {
    background-color: rgba(39, 174, 96, 0.15);
    border-color: rgba(46, 204, 113, 0.3);
    scale: 1.02;
}

.btn-nav--settings:hover {
    background-color: rgba(243, 156, 18, 0.15);
    border-color: rgba(241, 196, 15, 0.3);
    scale: 1.02;
}

.btn-nav--exit:hover {
    background-color: rgba(192, 57, 43, 0.15);
    border-color: rgba(231, 76, 60, 0.3);
    scale: 1.02;
}

/* --- Right Content Panel (Save Slots) --- */
.main-menu-slots-container {
    flex-grow: 1; /* Takes up the remaining space on the right[cite: 19] */
    height: 100%;
}

.main-menu-slots-container .unity-scroll-view__content-container {
    flex-direction: row;
    flex-wrap: wrap; /* Allows save cards to wrap to the next line */
    align-items: flex-start;
    justify-content: flex-start;
    padding: 40px;
    padding-bottom: 100px; /* Add extra padding at the bottom so the last slot isn't cut off */
}

/* --- Close Button --- */
.main-menu-close-button {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 40px;
    height: 40px;
    font-size: 30px;
    background-color: transparent;
    border-width: 0;
    color: var(--color-text-light);
    -unity-font-style: bold;
    transition-duration: 0.1s;
    z-index: 100;
}

.main-menu-close-button:hover {
    color: #c0392b;
    scale: 1.2;
}