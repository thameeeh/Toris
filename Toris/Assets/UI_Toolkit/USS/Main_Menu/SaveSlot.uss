.save-slot-card {
    width: 360px;
    margin: 25px;
    padding: 25px;
    flex-shrink: 0;
    flex-direction: column;
    justify-content: flex-start;
    background-color: var(--color-bg-panel);
    border-radius: 8px;
    border-width: 1px;
    border-color: var(--color-border-default);
    min-height: 280px;
}

.save-slot-card:hover {
    border-color: var(--color-border-highlight);
    background-color: var(--color-bg-panel-hover);
}

.slot-header {
    flex-direction: row;
    justify-content: space-between;
    border-bottom-width: 1px;
    border-bottom-color: var(--color-border-default);
    padding-bottom: 12px;
    margin-bottom: 20px;
}

.slot-date {
    font-size: 16px;
    opacity: 0.7;
}

.slot-stats-container {
    flex-grow: 1;
    justify-content: center;
}

.slot-stat-row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 12px;
}

.stat-label {
    font-size: 20px;
}

.stat-value {
    -unity-font-definition: url("project://database/Assets/Art/PixelArtGUI/Fonts/bitcell_memesbruh03.ttf?fileID=12800000&guid=65378f308d5a3fc428e7292ee3d8095b&type=3#bitcell_memesbruh03");
    font-size: 24px;
    color: var(--color-border-highlight);
    -unity-font-style: bold;
}

.slot-footer {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 10px;
}

.save-slot__delete-btn {
    -unity-font-definition: url("project://database/Assets/Art/PixelArtGUI/Fonts/bitcell_memesbruh03.ttf?fileID=12800000&guid=65378f308d5a3fc428e7292ee3d8095b&type=3#bitcell_memesbruh03");
    height: 35px;
    padding: 0 15px;
    background-color: rgba(255, 255, 255, 0.05);
    border-width: 1px;
    border-color: var(--color-border-default);
    color: var(--color-text-light);
    font-size: 18px;
    border-radius: 4px;
    transition-duration: 0.15s;
}

.save-slot__delete-btn:hover {
    background-color: rgb(192, 57, 43);
    border-color: rgb(231, 76, 60);
    color: white;
}

.save-slot__delete-btn:active {
    background-color: rgb(150, 45, 34);
    scale: 0.95;
}

.save-slot__delete-btn--disabled {
    background-color: #2c2c2c;
    border-color: #1a1a1a;
    color: #555555;
    opacity: 0.5;
}

.save-slot__delete-btn--disabled:hover {
    background-color: #2c2c2c;
    border-color: #1a1a1a;
    color: #555555;
}

.save-slot-wrapper {
    flex-shrink: 0;
    width: 360px;
    height: 240px;
    margin: 10px;
}
