.forge-subview-container {
    flex-grow: 1;
    padding: 10px;
    flex-direction: column;
}

.forge-top-panel {
    flex-grow: 0;
    flex-shrink: 0;
    height: 260px;
    align-items: center;
    justify-content: flex-start;
    border-bottom-width: 2px;
    border-bottom-color: var(--color-border-default);
    padding-top: 8px;
    padding-bottom: 20px;
    margin-bottom: 10px;
}

.forge-title {
    margin-bottom: 10px;
}

.forge-inputs-wrapper {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    height: 72px;
    flex-shrink: 0;
    margin-bottom: 8px;
}

.forge-plus-label {
    -unity-font-definition: url("project://database/Assets/Art/PixelArtGUI/Fonts/bitcell_memesbruh03.ttf?fileID=12800000&guid=65378f308d5a3fc428e7292ee3d8095b&type=3#bitcell_memesbruh03");
    color: var(--color-text-light);
    font-size: var(--font-size-h2);
    margin-left: 15px;
    margin-right: 15px;
    -unity-font-style: bold;
}

.forge-action-btn {
    height: 32px;
    min-height: 32px;
    margin-bottom: 8px;
    width: 160px;
    flex-shrink: 0;
}

.forge-slot {
    width: 72px;
    height: 72px;
    flex-shrink: 0;
    background-color: var(--color-bg-panel);
    border-width: 2px;
    border-color: var(--color-border-default);
    border-radius: 4px;
}

.forge-slot .item-slot {
    width: 100%;
    height: 100%;
    background-color: transparent;
    border-width: 0;
}

.forge-slot-result {
    width: 64px;
    height: 64px;
    flex-shrink: 0;
    background-color: var(--color-bg-dark);
    border-width: 2px;
    border-color: var(--color-border-highlight);
    border-radius: 4px;
    align-self: center;
}

.forge-slot-result .item-slot {
    width: 100%;
    height: 100%;
    background-color: transparent;
    border-width: 0;
}

.forge-bottom-panel {
    flex-grow: 1;
    flex-direction: column;
    padding-top: 10px;
}

.forge-recipe-header {
    -unity-font-definition: url("project://database/Assets/Art/PixelArtGUI/Fonts/bitcell_memesbruh03.ttf?fileID=12800000&guid=65378f308d5a3fc428e7292ee3d8095b&type=3#bitcell_memesbruh03");
    color: var(--color-text-light);
    font-size: var(--font-size-h3);
    -unity-font-style: bold;
    margin-bottom: 12px;
}

.forge-recipe-scroll {
    flex-grow: 1;
}

.forge-blueprint-row {
    min-height: 96px;
    max-height: 96px;
    margin-bottom: 8px;
    padding: 8px;
    flex-direction: row;
    align-items: center;
    background-color: var(--color-bg-panel);
    border-width: 1px;
    border-color: var(--color-border-default);
    border-radius: 4px;
    -unity-text-align: middle-left;
    justify-content: flex-start;
}

.forge-blueprint-row:hover {
    border-color: var(--color-border-highlight);
}

.forge-blueprint-row--selected {
    border-width: 2px;
    border-color: var(--color-coin-gold);
}

.forge-blueprint-row--locked {
    border-color: var(--color-border-default);
}

.forge-blueprint-row--available {
    opacity: 1;
}

.forge-blueprint-icon {
    width: 72px;
    height: 72px;
    flex-shrink: 0;
    margin-right: 14px;
}

.forge-blueprint-details {
    flex-grow: 1;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
}

.forge-blueprint-title {
    -unity-font-definition: url("project://database/Assets/Art/PixelArtGUI/Fonts/bitcell_memesbruh03.ttf?fileID=12800000&guid=65378f308d5a3fc428e7292ee3d8095b&type=3#bitcell_memesbruh03");
    color: var(--color-text-light);
    font-size: var(--font-size-body);
    -unity-font-style: bold;
    min-height: 30px;
    margin-bottom: 2px;
}

.forge-blueprint-requirements {
    color: var(--color-border-default);
    font-size: var(--font-size-small);
    min-height: 52px;
    white-space: normal;
}

.forge-recipe-scroll .unity-scroller--vertical {
    width: 14px;
    background-color: transparent;
    margin-left: 4px;
}

.forge-recipe-scroll .unity-scroller__low-button,
.forge-recipe-scroll .unity-scroller__high-button {
    display: none;
}

.forge-recipe-scroll .unity-scroller--vertical .unity-slider {
    margin: 0;
    background-color: transparent;
}

.forge-recipe-scroll .unity-scroller--vertical .unity-base-slider__tracker {
    background-color: var(--color-bg-shop);
    border-color: var(--color-shop-slot-border);
    border-width: 1px;
    border-radius: 4px;
}

.forge-recipe-scroll .unity-scroller--vertical .unity-base-slider__dragger {
    background-color: var(--color-border-highlight);
    border-color: var(--color-coin-gold);
    border-width: 1px;
    border-radius: 4px;
    width: 10px;
    left: auto;
    right: auto;
    margin-left: 0;
    margin-right: 0;
    align-self: center;
}

.forge-recipe-scroll .unity-scroller--vertical .unity-base-slider__dragger:hover {
    background-color: var(--color-coin-gold);
}
