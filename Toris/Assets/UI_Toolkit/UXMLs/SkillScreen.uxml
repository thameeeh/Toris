<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI_Toolkit/USS/theme-variables.uss?fileID=7433441132597879392&amp;guid=3ce3b574d9cc48546bcf181900c85e05&amp;type=3#theme-variables"/>
    <Style src="project://database/Assets/UI_Toolkit/USS/Skill_Screen.uss?fileID=7433441132597879392&amp;guid=3df4c339113f4eb4a9b0862fedb15197&amp;type=3#Skill_Screen"/>
    <ui:VisualElement name="skill-screen__root" class="skill-screen__root">
        
        <!-- Left Side: Selection & Tabs -->
        <ui:VisualElement name="skill-selection-panel" class="skill-selection-panel">
            <ui:VisualElement name="tabs-container" class="tabs-container">
                <ui:Button name="tab-btn-player" text="PLAYER" class="tab-button tab-button--active" />
                <ui:Button name="tab-btn-weapon" text="WEAPON" class="tab-button" />
            </ui:VisualElement>
            
            <ui:ScrollView mode="Vertical" name="skill-grid-scrollview" class="skill-grid-scrollview">
                <ui:VisualElement name="skill-grid-container" class="skill-grid-container">
                    <!-- Dynamic Skill Nodes instantiated here via C# -->
                </ui:VisualElement>
            </ui:ScrollView>
        </ui:VisualElement>

        <!-- Right Side: Info & Video -->
        <ui:VisualElement name="skill-info-panel" class="skill-info-panel">
            <ui:VisualElement name="video-preview-container" class="video-preview-container">
                <!-- Video RenderTexture displayed here -->
                <ui:Label text="VIDEO PREVIEW" class="video-placeholder-label" />
            </ui:VisualElement>

            <ui:VisualElement class="skill-info-panel__content">
                <ui:Label name="info-skill-name" text="Select a Skill" class="info-text-h2"/>
                <ui:Label name="info-skill-state" text="Status: -" class="info-text-body"/>
                <ui:Label name="info-skill-desc" text="Hover or click a skill node to see its details here." class="info-text-body" style="white-space: normal;"/>
            </ui:VisualElement>

            <ui:VisualElement class="skill-info-panel__footer">
                <ui:Label name="info-skill-cost" text="Cost: - SP" class="info-text-h3"/>
                <ui:Button name="btn-unlock-skill" text="UNLOCK" class="standard-button skill-unlock-btn"/>
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
