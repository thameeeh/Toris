.master-root {
    flex-grow: 1;
    picking-mode: Ignore;
}

.layer-windows {
    position: absolute;
    picking-mode: Ignore;
    width: 100%;
    height: 80%;
    justify-content: space-between;
    flex-direction: row;
    top: 0;
}

.left-zone {
    picking-mode: Ignore;
    height: 100%;
    width: 30%;
    min-width: 576px;
}

.right-zone {
    picking-mode: Ignore;
    width: 30%;
    height: 100%;
    min-width: 576px;
}

.layer-hud {
    picking-mode: Ignore;
    position: absolute;
    bottom: 0;
    height: auto;
    width: 100%;
}

.fullscreen-zone {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    right: 0;
    picking-mode: Ignore;
}

.item-tooltip {
    position: absolute;
    width: 320px;
    max-width: 320px;
    min-width: 240px;
    padding: 10px;
    background-color: rgba(12, 10, 9, 0.96);
    border-color: var(--color-border-highlight);
    border-width: 1px;
    border-radius: 4px;
    picking-mode: Ignore;
}

.item-tooltip__title {
    color: var(--color-text-light);
    font-size: 24px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.item-tooltip__description {
    color: rgb(205, 198, 188);
    font-size: 16px;
    white-space: normal;
    margin-bottom: 8px;
}

.item-tooltip__rows {
    border-top-width: 1px;
    border-top-color: rgba(220, 179, 92, 0.35);
    padding-top: 6px;
}

.item-tooltip__row {
    flex-direction: row;
    justify-content: space-between;
    min-height: 20px;
}

.item-tooltip__row-label {
    color: rgb(160, 154, 145);
    font-size: 16px;
    flex-grow: 1;
}

.item-tooltip__row-value {
    color: var(--color-text-light);
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    flex-grow: 1;
}
