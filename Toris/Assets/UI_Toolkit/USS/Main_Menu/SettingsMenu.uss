/* The wrapper that fills the TemplateContainer */
.settings-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    flex-direction: row;
    justify-content: flex-end; /* Pushes the child panel to the far right */
    picking-mode: Ignore; /* Lets clicks pass through the invisible left side */
}

/* The visible right-side panel */
.settings-panel {
    width: 65%; /* Takes up roughly the right two-thirds of the screen */
    height: 100%;
    
    /* Using your established theme variables */
    background-color: var(--color-bg-dark); 
    border-left-width: 2px;
    border-left-color: var(--color-border-default);
    
    padding: 60px;
    flex-direction: column;
    picking-mode: Position; /* Catches clicks so they don't hit the main menu underneath */
}

.settings-title {
    margin-bottom: 20px;
}

.settings-tabs {
    flex-direction: row;
    margin-bottom: 24px;
}

.settings-tab {
    width: 180px;
    flex-grow: 0;
}

.settings-content {
    flex-grow: 1; /* Fills all available vertical space, pushing the close button down */
    flex-direction: column;
    margin-bottom: 20px;
}

/* --- Added Slider Styles --- */
.settings-section-header {
    -unity-font-definition: url("project://database/Assets/Art/PixelArtGUI/Fonts/bitcell_memesbruh03.ttf?fileID=12800000&guid=65378f308d5a3fc428e7292ee3d8095b&type=3#bitcell_memesbruh03");
    font-size: 24px;
    -unity-font-style: bold;
    color: var(--color-border-highlight);
    margin-bottom: 15px;
    border-bottom-width: 1px;
    border-bottom-color: var(--color-border-default);
    padding-bottom: 5px;
}

.settings-section-spacing {
    margin-top: 40px;
}

.settings-slider-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 15px;
    padding-right: 20%; /* Keep sliders from hitting the very edge */
}

.settings-slider {
    width: 250px;
}

.settings-dropdown {
    width: 250px;
    font-size: var(--font-size-small);
}

.settings-action-row {
    flex-direction: row;
    justify-content: flex-end;
    padding-right: 20%;
    margin-bottom: 15px;
}

.settings-apply-button {
    width: 250px;
    height: 44px;
    font-size: var(--font-size-small);
}

.settings-control-status {
    color: var(--color-text-light);
    font-size: var(--font-size-body);
    margin-bottom: 14px;
}

.settings-controls-list {
    flex-direction: column;
    padding-right: 20%;
}

.settings-control-section {
    flex-direction: column;
}

.settings-control-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.settings-control-action {
    width: 190px;
    color: var(--color-text-light);
    font-size: var(--font-size-body);
}

.settings-control-binding {
    width: 130px;
    color: var(--color-border-highlight);
    font-size: var(--font-size-body);
}

.settings-control-button {
    width: 110px;
    height: 38px;
    margin-left: 8px;
    font-size: var(--font-size-small);
}

.settings-confirmation-overlay {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    background-color: rgba(0, 0, 0, 0.82);
    justify-content: center;
    align-items: center;
    picking-mode: Position;
}

.settings-confirmation-panel {
    width: 460px;
    min-height: 220px;
    background-color: var(--color-bg-dark);
    border-width: 2px;
    border-color: var(--color-border-highlight);
    padding: 28px;
    align-items: center;
}

.settings-confirmation-title {
    -unity-font-definition: url("project://database/Assets/Art/PixelArtGUI/Fonts/bitcell_memesbruh03.ttf?fileID=12800000&guid=65378f308d5a3fc428e7292ee3d8095b&type=3#bitcell_memesbruh03");
    color: var(--color-text-light);
    font-size: var(--font-size-h3);
    -unity-text-align: middle-center;
    margin-bottom: 18px;
}

.settings-confirmation-message {
    color: var(--color-text-light);
    font-size: var(--font-size-body);
    white-space: normal;
    -unity-text-align: middle-center;
    margin-bottom: 24px;
}

.settings-confirmation-buttons {
    flex-direction: row;
    justify-content: space-between;
    width: 100%;
}

.settings-confirmation-button {
    width: 46%;
    height: 46px;
    font-size: var(--font-size-small);
}

/* -------------------------- */

.settings-close-button {
    -unity-font-definition: url("project://database/Assets/Art/PixelArtGUI/Fonts/bitcell_memesbruh03.ttf?fileID=12800000&guid=65378f308d5a3fc428e7292ee3d8095b&type=3#bitcell_memesbruh03");
    height: 60px;
    width: 250px;
    align-self: flex-end; /* Aligns the button to the bottom right corner */
    font-size: var(--font-size-body);
}

/* ==========================================================================
   PREMIUM CUSTOM STYLES (Tabs, Sliders, Dropdowns, Toggles)
   ========================================================================== */

/* --- Interactive Tabs --- */
.settings-tab {
    background-color: rgba(0, 0, 0, 0.4);
    border-width: 1px;
    border-color: var(--color-border-default);
    border-radius: 0; /* Keep borders sharp */
    padding: 8px 16px;
    justify-content: center;
    align-items: center;
    transition-duration: 0.15s;
}

.settings-tab:hover {
    background-color: rgba(212, 160, 23, 0.08);
    border-color: var(--color-border-highlight);
}

.settings-tab.panel-tab--active {
    background-color: rgba(212, 160, 23, 0.15);
    border-width: 2px;
    border-color: var(--color-border-highlight);
}

.settings-tab .panel-tab-label {
    color: rgba(255, 255, 255, 0.6);
    font-size: var(--font-size-body);
    -unity-font-style: normal;
}

.settings-tab.panel-tab--active .panel-tab-label {
    color: var(--color-border-highlight);
    -unity-font-style: bold;
}

/* --- Premium Volume Sliders --- */
.settings-slider {
    height: 24px;
    justify-content: center;
}

.settings-slider .unity-base-slider__tracker {
    background-color: rgba(0, 0, 0, 0.5);
    border-color: var(--color-border-default);
    border-width: 1px;
    border-radius: 0; /* Sharp corners */
    height: 8px;
    margin-top: -4px; /* Center vertical alignment */
}

.settings-slider .unity-base-slider__dragger {
    background-color: var(--color-border-highlight);
    border-color: var(--color-coin-gold);
    border-width: 1px;
    border-radius: 0; /* Sharp corners */
    width: 12px;
    height: 18px;
    margin-top: -9px; /* Correctly center thumb vertically over track */
    transition-duration: 0.1s;
}

.settings-slider .unity-base-slider__dragger:hover {
    background-color: var(--color-coin-gold);
    border-color: var(--color-text-light);
    scale: 1.1;
}

/* --- Sleek Dropdown Fields --- */
.settings-dropdown .unity-dropdown-field__input {
    background-color: rgba(0, 0, 0, 0.5);
    border-color: var(--color-border-default);
    border-width: 1px;
    border-radius: 0; /* Sharp corners */
    padding: 4px 8px;
    color: var(--color-text-light);
    transition-duration: 0.15s;
}

.settings-dropdown .unity-dropdown-field__input:hover {
    border-color: var(--color-border-highlight);
    background-color: rgba(212, 160, 23, 0.05);
}

/* --- Custom Checkbox Toggles --- */
.settings-toggle {
    width: 250px;
    align-items: flex-end; /* Align checkmark container to the right */
}

.settings-toggle .unity-toggle__checkmark {
    background-color: rgba(30, 20, 50, 0.6); /* Mystical dark purple base */
    border-color: rgba(212, 160, 23, 0.5); /* Bright gold unchecked border outline */
    border-width: 1.5px;
    border-radius: 0; /* Sharp corners */
    width: 20px;
    height: 20px;
    margin: 0;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.1); /* Hide/fade checkmark when unchecked */
    transition-duration: 0.15s;
}

.settings-toggle:hover .unity-toggle__checkmark {
    border-color: var(--color-border-highlight);
    background-color: rgba(212, 160, 23, 0.15);
}

.settings-toggle .unity-toggle__checkmark:checked {
    background-color: rgba(212, 160, 23, 0.25); /* Gold background tint */
    border-color: var(--color-border-highlight);
    -unity-background-image-tint-color: var(--color-coin-gold); /* Bright glowing gold checkmark! */
}

/* --- Scrollbar Custom Styling for Settings Content Panels --- */

/* The main vertical scroller container */
.settings-content .unity-scroller--vertical {
    width: 14px;
    background-color: transparent;
    margin-left: 4px; 
}

/* Hide the default Unity up/down arrow buttons */
.settings-content .unity-scroller__low-button,
.settings-content .unity-scroller__high-button {
    display: none;
}

/* Kill the residual gray background on the slider container */
.settings-content .unity-scroller--vertical .unity-slider {
    margin: 0;
    background-color: transparent;
}

/* The background track (dark depth track) */
.settings-content .unity-scroller--vertical .unity-base-slider__tracker {
    background-color: rgba(0, 0, 0, 0.4);
    border-color: var(--color-border-default);
    border-width: 1px;
    border-radius: 4px;
}

/* The draggable thumb (Golden highlight dragger) */
.settings-content .unity-scroller--vertical .unity-base-slider__dragger {
    background-color: var(--color-border-highlight);
    border-color: var(--color-coin-gold);
    border-width: 1px;
    border-radius: 4px;
    width: 10px; 
    
    left: auto;
    right: auto;
    margin-left: 0;
    margin-right: 0;
    align-self: center; 
}

/* Draggable thumb hover state (Bright Gold) */
.settings-content .unity-scroller--vertical .unity-base-slider__dragger:hover {
    background-color: var(--color-coin-gold);
}


