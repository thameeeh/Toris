:root {
    -unity-font-definition: url("project://database/Assets/Art/PixelArtGUI/Fonts/VT323-Regular.ttf?fileID=12800000&guid=ebe3050e2f27e764ba8791f10bc0ba57&type=3#VT323-Regular");

    /* Global Colors */
    --color-bg-dark: rgba(30, 30, 30, 0.95);
    --color-bg-panel: rgba(0, 0, 0, 0.8);
    --color-bg-panel-hover: rgba(0, 0, 0, 0.95);
    --color-main-menu-bg: rgba(0, 0, 0, 0.19);
    --color-border-default: rgb(100, 100, 100);
    --color-border-highlight: rgb(220, 179, 92);
    --color-text-light: rgb(255, 255, 255);

    /* Bar Colors */
    --color-health: #D92323;
    --color-mana: #234BD9;
    --color-xp: #D9D923;

    /* Typography Defaults */
    --font-size-h1: 96px;
    --font-size-h2: 72px;
    --font-size-h3: 48px;
    --font-size-body: 32px;
    --font-size-small: 24px;
    --color-text-outline: rgba(0, 0, 0, 0.8);

    /* Commerce Specific Colors | Smith Shop*/
    --color-bg-shop: rgba(35, 25, 20, 0.98);
    --color-shop-slot-bg: rgba(15, 15, 15, 0.8);
    --color-shop-slot-border: rgb(150, 120, 60);
    --color-coin-gold: rgb(255, 220, 100);
}
