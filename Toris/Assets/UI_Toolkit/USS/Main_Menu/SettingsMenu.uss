/* ==========================================================================
   SETTINGS SCREEN LAYOUT (SettingsMenu.uss)
   Smith-inspired modal shell for global settings.
   ========================================================================== */

.settings-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
    picking-mode: Ignore;
}

.settings-backdrop {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    background-color: rgba(0, 0, 0, 0.76);
}

.settings-main-container {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    flex-direction: column;
    background-color: var(--color-bg-dark);
    border-width: 2px;
    border-color: var(--color-border-highlight);
    padding: 10px;
    picking-mode: Position;
}

.settings-header-section {
    flex-direction: row;
    align-items: flex-end;
    min-height: 62px;
    margin-bottom: 10px;
    border-bottom-width: 2px;
    border-bottom-color: var(--color-border-default);
}

.settings-title {
    flex-shrink: 0;
    -unity-text-align: middle-left;
    color: var(--color-text-light);
    font-size: var(--font-size-h2);
    margin-right: 20px;
    margin-bottom: 5px;
}

.settings-tabs {
    flex-direction: row;
    flex-grow: 0;
    align-items: flex-end;
}

.settings-tab {
    width: 220px;
    flex-grow: 0;
    height: 44px;
}

.settings-tab .panel-tab-label {
    color: rgba(255, 255, 255, 0.62);
    font-size: 22px;
}

.settings-tab.panel-tab--active .panel-tab-label {
    color: var(--color-text-light);
}

.settings-middle-panel {
    flex-grow: 1;
    flex-shrink: 1;
    width: 100%;
    min-height: 0;
    margin-bottom: 10px;
    overflow: hidden;
}

.settings-content {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    height: 100%;
    padding: 14px 30px 18px 30px;
}

.settings-content .unity-scroll-view__content-container {
    padding-bottom: 52px;
}

.settings-section-header {
    -unity-font-definition: url("project://database/Assets/Art/PixelArtGUI/Fonts/bitcell_memesbruh03.ttf?fileID=12800000&guid=65378f308d5a3fc428e7292ee3d8095b&type=3#bitcell_memesbruh03");
    font-size: 24px;
    -unity-font-style: bold;
    color: var(--color-border-highlight);
    margin-bottom: 15px;
    border-bottom-width: 1px;
    border-bottom-color: var(--color-border-default);
    padding-bottom: 5px;
}

.settings-section-spacing {
    margin-top: 34px;
}

.settings-slider-row {
    width: 78%;
    max-width: 860px;
    min-width: 620px;
    align-self: center;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 15px;
}

.settings-slider {
    width: 340px;
    height: 24px;
    justify-content: center;
}

.settings-dropdown {
    width: 340px;
    height: 38px;
    font-size: var(--font-size-small);
}

.settings-action-row {
    width: 78%;
    max-width: 860px;
    min-width: 620px;
    align-self: center;
    flex-direction: row;
    justify-content: flex-end;
    margin-bottom: 15px;
}

.settings-apply-button {
    width: 250px;
    height: 44px;
    font-size: var(--font-size-small);
}

.settings-control-status {
    width: 88%;
    align-self: center;
    color: var(--color-text-light);
    font-size: var(--font-size-body);
    margin-bottom: 14px;
}

.settings-controls-list {
    width: 88%;
    max-width: 980px;
    align-self: center;
    flex-direction: column;
}

.settings-control-section {
    width: 88%;
    max-width: 980px;
    align-self: center;
    flex-direction: column;
}

.settings-control-row {
    flex-direction: row;
    align-items: center;
    min-height: 48px;
    margin-bottom: 10px;
    padding: 6px 8px;
    background-color: var(--color-bg-panel);
    border-width: 1px;
    border-color: var(--color-border-default);
    border-radius: 4px;
}

.settings-control-action {
    width: 230px;
    color: var(--color-text-light);
    font-size: var(--font-size-body);
}

.settings-control-binding {
    width: 160px;
    color: var(--color-border-highlight);
    font-size: var(--font-size-body);
}

.settings-control-button {
    width: 110px;
    height: 38px;
    margin-left: 8px;
    font-size: var(--font-size-small);
}

.settings-footer-section {
    flex-direction: row;
    flex-shrink: 0;
    justify-content: flex-end;
    min-height: 56px;
    border-top-width: 1px;
    border-top-color: var(--color-border-default);
    padding-top: 10px;
}

.settings-close-button {
    -unity-font-definition: url("project://database/Assets/Art/PixelArtGUI/Fonts/bitcell_memesbruh03.ttf?fileID=12800000&guid=65378f308d5a3fc428e7292ee3d8095b&type=3#bitcell_memesbruh03");
    height: 42px;
    width: 220px;
    font-size: var(--font-size-body);
}

/* --- Slider Controls --- */

.settings-slider .unity-base-slider__tracker {
    background-color: rgba(0, 0, 0, 0.5);
    border-color: var(--color-border-default);
    border-width: 1px;
    border-radius: 0;
    height: 8px;
    margin-top: -4px;
}

.settings-slider .unity-base-slider__dragger {
    background-color: var(--color-border-highlight);
    border-color: var(--color-coin-gold);
    border-width: 1px;
    border-radius: 0;
    width: 12px;
    height: 18px;
    margin-top: -9px;
    transition-duration: 0.1s;
}

.settings-slider .unity-base-slider__dragger:hover {
    background-color: var(--color-coin-gold);
    border-color: var(--color-text-light);
    scale: 1.1;
}

/* --- Dropdown Fields --- */

.settings-dropdown .unity-base-popup-field__input,
.settings-dropdown .unity-dropdown-field__input {
    background-color: rgba(0, 0, 0, 0.5);
    border-color: var(--color-border-default);
    border-width: 1px;
    border-radius: 0;
    padding: 4px 8px;
    color: var(--color-text-light);
    transition-duration: 0.15s;
}

.settings-dropdown .unity-base-popup-field__input:hover,
.settings-dropdown .unity-dropdown-field__input:hover {
    border-color: var(--color-border-highlight);
    background-color: rgba(212, 160, 23, 0.05);
}

.settings-dropdown .unity-base-popup-field__text {
    color: var(--color-text-light);
}

.settings-dropdown .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: var(--color-border-highlight);
}

.settings-dropdown:disabled .unity-base-popup-field__input,
.settings-dropdown:disabled .unity-dropdown-field__input {
    background-color: rgba(100, 100, 100, 0.22);
    border-color: rgba(255, 255, 255, 0.18);
}

.settings-dropdown:disabled .unity-base-popup-field__text {
    color: rgba(255, 255, 255, 0.45);
}

/* --- Toggles --- */

.settings-toggle {
    width: 340px;
    align-items: flex-end;
}

.settings-toggle .unity-toggle__checkmark {
    background-color: rgba(30, 20, 50, 0.6);
    border-color: rgba(212, 160, 23, 0.5);
    border-width: 1.5px;
    border-radius: 0;
    width: 20px;
    height: 20px;
    margin: 0;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.1);
    transition-duration: 0.15s;
}

.settings-toggle:hover .unity-toggle__checkmark {
    border-color: var(--color-border-highlight);
    background-color: rgba(212, 160, 23, 0.15);
}

.settings-toggle .unity-toggle__checkmark:checked {
    background-color: rgba(212, 160, 23, 0.25);
    border-color: var(--color-border-highlight);
    -unity-background-image-tint-color: var(--color-coin-gold);
}

/* --- Scrollbars --- */

.settings-content .unity-scroller--vertical {
    width: 14px;
    background-color: transparent;
    margin-left: 4px;
}

.settings-content .unity-scroller__low-button,
.settings-content .unity-scroller__high-button {
    display: none;
}

.settings-content .unity-scroller--vertical .unity-slider {
    margin: 0;
    background-color: transparent;
}

.settings-content .unity-scroller--vertical .unity-base-slider__tracker {
    background-color: rgba(0, 0, 0, 0.4);
    border-color: var(--color-border-default);
    border-width: 1px;
    border-radius: 4px;
}

.settings-content .unity-scroller--vertical .unity-base-slider__dragger {
    background-color: var(--color-border-highlight);
    border-color: var(--color-coin-gold);
    border-width: 1px;
    border-radius: 4px;
    width: 10px;
    left: auto;
    right: auto;
    margin-left: 0;
    margin-right: 0;
    align-self: center;
}

.settings-content .unity-scroller--vertical .unity-base-slider__dragger:hover {
    background-color: var(--color-coin-gold);
}

/* --- Display Confirmation Overlay --- */

.settings-confirmation-overlay {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    background-color: rgba(0, 0, 0, 0.82);
    justify-content: center;
    align-items: center;
    picking-mode: Position;
}

.settings-confirmation-panel {
    width: 460px;
    min-height: 220px;
    background-color: var(--color-bg-dark);
    border-width: 2px;
    border-color: var(--color-border-highlight);
    padding: 28px;
    align-items: center;
}

.settings-confirmation-title {
    -unity-font-definition: url("project://database/Assets/Art/PixelArtGUI/Fonts/bitcell_memesbruh03.ttf?fileID=12800000&guid=65378f308d5a3fc428e7292ee3d8095b&type=3#bitcell_memesbruh03");
    color: var(--color-text-light);
    font-size: var(--font-size-h3);
    -unity-text-align: middle-center;
    margin-bottom: 18px;
}

.settings-confirmation-message {
    color: var(--color-text-light);
    font-size: var(--font-size-body);
    white-space: normal;
    -unity-text-align: middle-center;
    margin-bottom: 24px;
}

.settings-confirmation-buttons {
    flex-direction: row;
    justify-content: space-between;
    width: 100%;
}

.settings-confirmation-button {
    width: 46%;
    height: 46px;
    font-size: var(--font-size-small);
}
