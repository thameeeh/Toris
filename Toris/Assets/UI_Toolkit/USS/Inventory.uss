/* ==========================================================================
   PLAYER INVENTORY LAYOUT (Inventory.uss)
   Structural wrappers and grid layouts for the main character screen.
   ========================================================================== */

.player-inventory-root {
    picking-mode: Ignore;
    flex-shrink: 0;
    flex-grow: 1;
    width: 100%;
    height: 100%;
    overflow: visible;
}

.inventory-window {
    width: 100%;
    height: 100%;
    background-color: var(--color-bg-dark);
    border-color: rgb(212, 160, 23);
    border-width: 2px;
    flex-direction: column;
    padding: 10px;
}

.player-inventory-container {
    flex-grow: 1;
    background-color: var(--color-bg-dark);
    picking-mode: Position;
    flex-shrink: 0;
    align-items: stretch;
    justify-content: space-between;
    overflow: visible;
}

.player-top-section {
    flex-grow: 1;
    flex-direction: row;
    position: relative;
    overflow: visible;
}

.player-stats-panel {
    position: absolute;
    left: -352px;
    top: 0;
    bottom: 0;
    width: 384px;
    opacity: 0;
    picking-mode: Ignore;
    background-color: var(--color-bg-panel);
    border-width: 2px;
    border-color: var(--color-border-default);
    border-top-left-radius: 6px;
    border-bottom-left-radius: 6px;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    padding: 15px;
    transition-property: left, opacity;
    transition-duration: 0.14s;
}

.player-inventory-container--stats-open .player-stats-panel {
    left: -384px;
    opacity: 1;
    picking-mode: Position;
}

.player-stats-panel .panel-title {
    font-size: var(--font-size-h3);
}

.player-stats-panel .stat-label {
    font-size: var(--font-size-small);
    white-space: normal;
}

.stats-scroll-view {
    flex-grow: 1;
}

.player-equipment-wrapper {
    flex-grow: 1;
    flex-basis: 0;
    display: flex;
}

.player-equipment-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-left: 10px;
    padding-right: 10px;
}

/* Brought over from the Components.uss purge */
.player-equipment-header .panel-title {
    margin-bottom: 0;
    -unity-text-align: middle-right;
}

.inventory-stats-toggle {
    min-width: 110px;
    height: 54px;
    font-size: var(--font-size-body);
    margin-left: 12px;
    padding-left: 10px;
    padding-right: 10px;
}

.inventory-stats-toggle--open {
    border-color: var(--color-border-highlight);
    background-color: var(--color-bg-panel-hover);
}

.player-equipment-panel {
    background-color: var(--color-bg-panel);
    -unity-background-scale-mode: scale-to-fit;
    flex-grow: 1;
    /* Extracted the inline background image from UXML */
    background-image: url("project://database/Assets/UI_Toolkit/BowGuy007.png?fileID=2800000&guid=d2a0ea75174bdc740a7b12c0072b8de5&type=3#BowGuy007");
}

.player-inventory-slots-panel {
    flex-grow: 0;
    margin-bottom: 0;
    height: 20%;
    min-height: 248px;
    border-top-width: 2px;
    border-top-color: var(--color-border-default);
}

.inventory-slots-scroll {
    flex-grow: 1;
    height: 100%;
}

.inventory-grid-container {
    flex-direction: row;
    flex-wrap: wrap;
}

.inventory-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
}
