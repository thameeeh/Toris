.master-root {
    flex-grow: 1;
    picking-mode: Ignore;
}

.layer-windows {
    position: absolute;
    picking-mode: Ignore;
    width: 100%;
    height: 80%;
    justify-content: space-between;
    flex-direction: row;
    top: 0;
}

.left-zone {
    picking-mode: Ignore;
    height: 100%;
    width: 30%;
    min-width: 576px;
}

.right-zone {
    picking-mode: Ignore;
    width: 30%;
    height: 100%;
    min-width: 576px;
}

.layer-hud {
    picking-mode: Ignore;
    position: absolute;
    bottom: 0;
    height: auto;
    width: 100%;
}

.fullscreen-zone {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    right: 0;
    picking-mode: Ignore;
}

.item-tooltip {
    position: absolute;
    width: 460px;
    max-width: 460px;
    min-width: 360px;
    padding: 18px;
    background-color: rgba(12, 10, 9, 0.96);
    border-color: var(--color-border-highlight);
    border-width: 1px;
    border-radius: 4px;
    picking-mode: Ignore;
}

.item-tooltip__title {
    color: var(--color-text-light);
    font-size: var(--font-size-body);
    -unity-font-style: bold;
    margin-bottom: 10px;
}

.item-tooltip__description {
    color: rgb(205, 198, 188);
    font-size: var(--font-size-small);
    white-space: normal;
    margin-bottom: 14px;
}

.item-tooltip__rows {
    border-top-width: 1px;
    border-top-color: rgba(220, 179, 92, 0.35);
    padding-top: 12px;
}

.item-tooltip__row {
    flex-direction: row;
    justify-content: space-between;
    min-height: 34px;
    margin-bottom: 4px;
}

.item-tooltip__row-label {
    color: rgb(160, 154, 145);
    font-size: var(--font-size-small);
    flex-grow: 1;
}

.item-tooltip__row-value {
    color: var(--color-text-light);
    font-size: var(--font-size-small);
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    flex-grow: 1;
}
