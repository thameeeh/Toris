#hud__bottom-section {
    flex-direction: row;
    align-items: flex-end;
    width: 100%;
    height: 150px;
    padding-bottom: 20px;
    padding-left: 20px;
    padding-right: 20px;
}

#hud__left-container {
    width: 300px;
    flex-shrink: 1;
    flex-grow: 0.1;
}

#hud__right-container {
    min-width: 380px;
    margin-left: auto;
    align-items: flex-end;
}

#hud__menu-section {
    flex-grow: 0;
    align-items: flex-start;
    flex-direction: column-reverse;
    margin-bottom: 10px;
    padding-left: 20px;
}

.hud-menu-btn {
    width: 60px;
    height: 60px;
    -unity-background-scale-mode: scale-to-fit;
    background-color: transparent;
    border-width: 0;
}

.hud-menu-container {
    display: none;
    position: absolute;
    bottom: 70px;
    left: 20px;
    padding-bottom: 10px;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.57);
}

.hud-menu-icon {
    width: 50px;
    height: 50px;
    margin-bottom: 5px;
}

.HUD {
    color: var(--color-text-light);
    -unity-font-style: bold;
    font-size: 22px;
    letter-spacing: 2px;
    -unity-text-outline-width: 1.5px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.8);
}

.hud-label-xp {
    min-width: 60px;
    color: var(--color-xp);
}

.hud-bar-text-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    -unity-text-align: middle-center;
    font-size: 18px;
    letter-spacing: 4px;
    -unity-text-outline-width: 1.5px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.9);
    bottom: 4px;
}

.hud-bar-row {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    margin-bottom: 5px;
}

.hud-bar-header {
    flex-grow: 1;
    flex-direction: row-reverse;
    justify-content: space-between;
    align-self: stretch;
    margin-bottom: 5px;
}

#hud__xp-bar {
    flex-grow: 1;
    height: 15px;
}

#hud__health-bar {
    flex-grow: 1;
    height: 35px;
}

#hud__mana-bar {
    width: 100%;
    height: 35px;
    margin-bottom: 5px;
}

.unity-progress-bar {
    margin: 0;
    padding: 0;
}

.unity-progress-bar__title {
    display: none;
}

.unity-progress-bar__background {
    background-color: rgba(15, 15, 15, 0.9);
    border-color: rgb(0, 0, 0);
    border-width: 2px;
    border-radius: 8px;
    overflow: hidden;
}

.unity-progress-bar__progress {
    border-radius: 5px;
    margin: 1px;
}

#hud__xp-bar .unity-progress-bar__progress {
    background-color: var(--color-xp);
}

#hud__health-bar .unity-progress-bar__progress {
    background-color: var(--color-health);
}

#hud__mana-bar .unity-progress-bar__progress {
    background-color: var(--color-mana);
}

.hud-potion-bar {
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
    margin-left: 20px;
    margin-right: auto;
    margin-bottom: 5px;
    padding: 10px;
    background-color: rgba(0, 0, 0, 0.4);
    border-radius: 12px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.1);
    overflow: visible; /* Added to prevent hotkey clipping */
}

.potion-slot--hud {
    width: 64px;
    height: 64px;
    margin: 12px 5px 12px 5px; /* Consistent top/bottom margin */
    background-color: rgba(15, 15, 15, 0.8);
    border-width: 2px;
    border-color: var(--color-border-default);
    border-radius: 8px;
    justify-content: flex-end;
    align-items: center;
    overflow: visible; /* Added */
}

.hud-potion-hotkey {
    position: absolute;
    top: -12px;
    color: var(--color-text-light);
    font-size: 14px;
    -unity-font-style: bold;
    background-color: rgba(0, 0, 0, 0.8);
    padding: 2px 6px;
    border-radius: 4px;
    border-width: 1px;
    border-color: var(--color-border-highlight);
}

.hud-skill-bar {
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    padding: 10px;
    background-color: rgba(0, 0, 0, 0.4);
    border-radius: 12px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.1);
    overflow: visible; /* Added to prevent hotkey clipping */
}

.skill-slot--hud {
    width: 64px;
    height: 64px;
    margin: 12px 5px 12px 5px; /* Consistent top/bottom margin */
    background-color: rgba(15, 15, 15, 0.8);
    border-width: 2px;
    border-color: var(--color-border-default);
    border-radius: 8px;
    justify-content: flex-end;
    align-items: center;
    overflow: visible; /* Added */
}

.hud-skill-hotkey {
    position: absolute;
    top: -12px;
    color: var(--color-text-light);
    font-size: 14px;
    -unity-font-style: bold;
    background-color: rgba(0, 0, 0, 0.8);
    padding: 2px 6px;
    border-radius: 4px;
    border-width: 1px;
    border-color: var(--color-border-highlight);
}
