.main-menu-root {
    picking-mode: Ignore;
    flex-shrink: 0;
    flex-grow: 1;
    width: 100%;
    height: 100%;
    flex-direction: row;
    background-color: var(--color-main-menu-bg);
}

.main-menu-nav-panel {
    width: 350px;
    height: 100%;
    flex-shrink: 0;
    flex-direction: column;
    justify-content: center;
    padding: 20px;
    background-color: var(--color-bg-panel);
    border-right-width: 2px;
    border-right-color: var(--color-border-default);
}

.main-menu-title {
    font-size: var(--font-size-h1);
    -unity-text-align: middle-center;
    margin-bottom: 60px;
    white-space: normal;
}

.main-menu-button-group {
    flex-direction: column;
    align-items: stretch;
}

.main-menu-button {
    height: 60px;
    margin-bottom: 15px;
    font-size: var(--font-size-h3);
}

.btn-nav--play:hover {
    background-color: rgba(39, 174, 96, 0.15);
    border-color: rgba(46, 204, 113, 0.3);
    scale: 1.02;
}

.btn-nav--settings:hover {
    background-color: rgba(243, 156, 18, 0.15);
    border-color: rgba(241, 196, 15, 0.3);
    scale: 1.02;
}

.btn-nav--exit:hover {
    background-color: rgba(192, 57, 43, 0.15);
    border-color: rgba(231, 76, 60, 0.3);
    scale: 1.02;
}

.main-menu-slots-container {
    flex-grow: 1;
    height: 100%;
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.save-slots-scrollview {
    flex-grow: 1;
}

.main-menu-slots-container .unity-scroll-view__content-container {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: flex-start;
    padding: 40px;
    padding-bottom: 100px;
}

.main-menu-close-button {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 40px;
    height: 40px;
    font-size: 30px;
    background-color: transparent;
    border-width: 0;
    color: var(--color-text-light);
    -unity-font-style: bold;
    transition-duration: 0.1s;
    z-index: 100;
}

.main-menu-close-button:hover {
    color: rgb(192, 57, 43);
    scale: 1.2;
}
