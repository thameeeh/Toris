/* ==========================================================================
   SAGE WEAPON UPGRADE SYSTEM STYLES (SageUpgrade.uss)
   Premium mystical/alchemical theme (amethyst background, gold highlights).
   ========================================================================== */

.sage-root-wrapper {
    flex-grow: 1;
    width: 100%;
    height: 100%;
}

.sage-main-container {
    flex-grow: 1;
    flex-direction: column;
    /* Deep amethyst gradient */
    background-color: rgb(26, 10, 46);
    background-image: linear-gradient(to bottom, rgba(26, 10, 46, 0.98), rgba(45, 27, 105, 0.98));
    border-width: 2px;
    border-color: rgb(212, 160, 23); /* Gold border highlight */
    width: 100%;
    height: 100%;
    padding: 20px;
}

/* --- HEADER SECTION --- */
.sage-header-section {
    flex-direction: row;
    align-items: flex-end;
    margin-bottom: 20px;
    border-bottom-width: 2px;
    border-bottom-color: rgba(212, 160, 23, 0.5); /* Semi-transparent gold separator */
    padding-bottom: 8px;
}

.sage-title {
    flex-shrink: 0;
    -unity-text-align: middle-left;
    color: rgb(255, 255, 255);
    font-size: var(--font-size-h2);
    margin-right: 20px;
    -unity-font-style: bold;
}

.sage-subtitle {
    flex-grow: 1;
    -unity-text-align: bottom-left;
    color: rgb(212, 160, 23);
    font-size: var(--font-size-small);
    margin-bottom: 5px;
    letter-spacing: 1px;
}

/* --- BODY SECTION --- */
.sage-body-panel {
    flex-grow: 1;
    flex-direction: row;
    width: 100%;
    height: 100%;
}

.sage-column {
    height: 100%;
}

/* --- LEFT PANEL: WEAPON LIST --- */
.sage-list-panel {
    width: 45%;
    border-right-width: 1px;
    border-right-color: rgba(212, 160, 23, 0.2);
    padding-right: 15px;
}

.sage-section-title {
    -unity-font-definition: url("project://database/Assets/Art/PixelArtGUI/Fonts/bitcell_memesbruh03.ttf?fileID=12800000&guid=65378f308d5a3fc428e7292ee3d8095b&type=3#bitcell_memesbruh03");
    color: rgb(212, 160, 23);
    font-size: var(--font-size-h3);
    margin-bottom: 15px;
    -unity-font-style: bold;
}

.sage-weapon-scroll {
    flex-grow: 1;
}

/* Weapon List Item Row */
.sage-weapon-row {
    flex-direction: row;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.4);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    border-radius: 6px;
    padding: 10px;
    margin-bottom: 8px;
    transition-duration: 0.15s;
    transition-property: all;
}

.sage-weapon-row:hover {
    background-color: rgba(45, 27, 105, 0.6);
    border-color: rgb(212, 160, 23);
    scale: 1.02;
}

.sage-weapon-row--selected {
    background-color: rgba(212, 160, 23, 0.15);
    border-color: rgb(212, 160, 23);
}

.sage-row-icon {
    width: 48px;
    height: 48px;
    margin-right: 12px;
}

.sage-row-name {
    flex-grow: 1;
    color: rgb(255, 255, 255);
    font-size: var(--font-size-body);
}

.sage-row-level {
    background-color: rgba(0, 0, 0, 0.6);
    color: rgb(212, 160, 23);
    font-size: var(--font-size-small);
    padding: 2px 6px;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgb(212, 160, 23);
}

/* Grayed out / Disabled list item when weapon is already max level */
.sage-weapon-row--max-level {
    opacity: 0.5;
}

.sage-row-level--max {
    color: rgb(233, 75, 75);
    border-color: rgb(233, 75, 75);
}

/* Empty State Message */
.sage-empty-label {
    color: rgba(255, 255, 255, 0.4);
    font-size: var(--font-size-body);
    -unity-text-align: middle-center;
    margin-top: 50px;
    -unity-font-style: italic;
}

/* --- RIGHT PANEL: DETAILED SCREEN --- */
.sage-detail-panel {
    width: 55%;
    padding-left: 20px;
    justify-content: space-between;
}

.sage-detail-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 20px;
}

.sage-selected-slot-container {
    width: 90px;
    height: 90px;
    background-color: rgba(0, 0, 0, 0.5);
    border-width: 2px;
    border-color: rgb(212, 160, 23);
    border-radius: 8px;
    margin-right: 15px;
    justify-content: center;
    align-items: center;
}

.sage-detail-icon {
    width: 80%;
    height: 80%;
}

.sage-detail-name {
    color: rgb(255, 255, 255);
    font-size: var(--font-size-h3);
    -unity-font-style: bold;
    flex-wrap: wrap;
    flex-grow: 1;
}

/* --- STATS COMPARISON PANEL --- */
.sage-stats-container {
    background-color: rgba(0, 0, 0, 0.3);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.05);
    border-radius: 8px;
    padding: 15px;
    margin-bottom: 20px;
}

.sage-stat-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 8px 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.05);
}

.sage-stat-row:last-child {
    border-bottom-width: 0;
}

.sage-stat-label {
    color: rgba(255, 255, 255, 0.7);
    font-size: var(--font-size-body);
    width: 45%;
}

.sage-stat-val {
    color: rgb(255, 255, 255);
    font-size: var(--font-size-body);
    -unity-text-align: middle-center;
}

.sage-stat-arrow {
    color: rgba(255, 255, 255, 0.3);
    font-size: var(--font-size-small);
    -unity-text-align: middle-center;
    margin: 0 10px;
}

.val-green {
    color: rgb(46, 204, 113);
    -unity-font-style: bold;
}

/* --- COSTS & UPGRADE SECTION --- */
.sage-action-container {
    background-color: rgba(0, 0, 0, 0.5);
    border-width: 1px;
    border-color: rgba(212, 160, 23, 0.3);
    border-radius: 8px;
    padding: 15px;
}

.sage-cost-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
}

.sage-cost-label {
    color: rgba(255, 255, 255, 0.7);
    font-size: var(--font-size-body);
}

.sage-cost-value {
    color: rgb(255, 220, 100); /* Golden color for cost */
    font-size: var(--font-size-body);
    -unity-font-style: bold;
}

.sage-gold-value {
    color: rgb(255, 255, 255);
    font-size: var(--font-size-body);
}

/* Upgrade Button styling */
.sage-upgrade-btn {
    margin-top: 15px;
    height: 55px;
    font-size: 28px;
    -unity-font-style: bold;
    background-color: rgb(212, 160, 23);
    border-color: rgb(255, 220, 100);
    border-width: 2px;
    color: rgb(0, 0, 0);
    transition-duration: 0.15s;
    transition-property: all;
    border-radius: 6px;
}

.sage-upgrade-btn:hover {
    background-color: rgb(255, 220, 100);
    scale: 1.03;
}

.sage-upgrade-btn:disabled {
    background-color: rgb(60, 60, 60);
    border-color: rgb(80, 80, 80);
    color: rgb(150, 150, 150);
    opacity: 0.6;
}

/* --- MIDDLE PANEL & TAB NAVIGATION --- */
.sage-middle-panel {
    flex-grow: 1;
    width: 100%;
    height: 100%;
}

/* Custom Sage Tab Styles to skin the global panel tabs in mystical amethyst & gold */
.sage-main-container .panel-tab {
    background-color: rgba(0, 0, 0, 0.4);
    border-color: rgba(212, 160, 23, 0.3);
}

.sage-main-container .panel-tab:hover {
    background-color: rgba(45, 27, 105, 0.6);
    border-color: rgb(212, 160, 23);
}

.sage-main-container .panel-tab--active {
    background-color: rgba(212, 160, 23, 0.15);
    border-color: rgb(212, 160, 23);
}

.sage-main-container .panel-tab-label {
    color: rgba(212, 160, 23, 0.6);
}

.sage-main-container .panel-tab--active .panel-tab-label {
    color: rgb(212, 160, 23);
}

/* --- MINIMALIST LAYOUT STYLES --- */
.sage-body-panel--minimal {
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding: 10px 0;
    width: 100%;
    height: 100%;
}

.sage-input-section {
    align-items: center;
    margin-top: 10px;
    margin-bottom: 20px;
    width: 100%;
}

.sage-instruction-text {
    -unity-font-definition: url("project://database/Assets/Art/PixelArtGUI/Fonts/bitcell_memesbruh03.ttf?fileID=12800000&guid=65378f308d5a3fc428e7292ee3d8095b&type=3#bitcell_memesbruh03");
    color: rgba(212, 160, 23, 0.7);
    font-size: 24px;
    margin-bottom: 12px;
    -unity-font-style: bold;
}

.sage-upgrade-slot-container {
    width: 90px;
    height: 90px;
    background-color: rgba(0, 0, 0, 0.5);
    border-width: 2px;
    border-color: rgb(212, 160, 23);
    border-radius: 8px;
    margin-bottom: 12px;
    justify-content: center;
    align-items: center;
}

.sage-upgrade-slot-container .item-slot {
    width: 100%;
    height: 100%;
    background-color: transparent;
    border-width: 0;
}

.sage-detail-name-minimal {
    color: rgb(255, 255, 255);
    font-size: var(--font-size-h3);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.sage-stats-container--minimal {
    width: 100%;
    background-color: rgba(0, 0, 0, 0.3);
    border-width: 1px;
    border-color: rgba(212, 160, 23, 0.2);
    border-radius: 8px;
    padding: 12px 20px;
    margin-bottom: 20px;
}

.sage-action-container--minimal {
    width: 100%;
    background-color: rgba(0, 0, 0, 0.5);
    border-width: 1px;
    border-color: rgba(212, 160, 23, 0.3);
    border-radius: 8px;
    padding: 15px 20px;
}

/* --- SAGE POTION BREWING VIEW --- */
.brew-subview-container {
    flex-grow: 1;
    background-color: rgba(26, 10, 46, 0.4);
    padding: 10px;
    flex-direction: column;
}

.brew-top-panel {
    flex-grow: 0;
    flex-shrink: 0;
    height: 260px;
    align-items: center;
    justify-content: flex-start;
    border-bottom-width: 2px;
    border-bottom-color: rgba(212, 160, 23, 0.3);
    padding-top: 8px;
    padding-bottom: 20px;
    margin-bottom: 10px;
}

.brew-inputs-wrapper {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    height: 72px;
    flex-shrink: 0;
    margin-bottom: 8px;
}

.brew-plus-label {
    -unity-font-definition: url("project://database/Assets/Art/PixelArtGUI/Fonts/bitcell_memesbruh03.ttf?fileID=12800000&guid=65378f308d5a3fc428e7292ee3d8095b&type=3#bitcell_memesbruh03");
    color: rgb(212, 160, 23);
    font-size: var(--font-size-h2);
    margin-left: 15px;
    margin-right: 15px;
    -unity-font-style: bold;
}

.brew-action-btn {
    height: 32px;
    min-height: 32px;
    margin-bottom: 8px;
    width: 160px;
    flex-shrink: 0;
}

.brew-slot {
    width: 72px;
    height: 72px;
    flex-shrink: 0;
    background-color: rgba(0, 0, 0, 0.5);
    border-width: 2px;
    border-color: rgba(212, 160, 23, 0.3);
    border-radius: 6px;
}

.brew-slot .item-slot {
    width: 100%;
    height: 100%;
    background-color: transparent;
    border-width: 0;
}

.brew-slot-result {
    width: 64px;
    height: 64px;
    flex-shrink: 0;
    background-color: rgba(0, 0, 0, 0.6);
    border-width: 2px;
    border-color: rgb(212, 160, 23);
    border-radius: 6px;
    align-self: center;
}

.brew-slot-result .item-slot {
    width: 100%;
    height: 100%;
    background-color: transparent;
    border-width: 0;
}

.brew-bottom-panel {
    flex-grow: 1;
    flex-direction: column;
    padding-top: 10px;
}

.brew-recipe-header {
    -unity-font-definition: url("project://database/Assets/Art/PixelArtGUI/Fonts/bitcell_memesbruh03.ttf?fileID=12800000&guid=65378f308d5a3fc428e7292ee3d8095b&type=3#bitcell_memesbruh03");
    color: rgb(212, 160, 23);
    font-size: var(--font-size-h3);
    -unity-font-style: bold;
    margin-bottom: 12px;
}

.brew-recipe-scroll {
    flex-grow: 1;
}

.brew-blueprint-row {
    min-height: 96px;
    max-height: 96px;
    margin-bottom: 8px;
    padding: 8px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.4);
    border-width: 1px;
    border-color: rgba(212, 160, 23, 0.2);
    border-radius: 6px;
    -unity-text-align: middle-left;
    justify-content: flex-start;
    transition-duration: 0.1s;
}

.brew-blueprint-row:hover {
    background-color: rgba(45, 27, 105, 0.6);
    border-color: rgb(212, 160, 23);
}

.brew-blueprint-row--selected {
    border-width: 2px;
    border-color: rgb(212, 160, 23);
    background-color: rgba(212, 160, 23, 0.15);
}

.brew-blueprint-row--locked {
    opacity: 0.6;
}

.brew-blueprint-row--available {
    opacity: 1;
}

.brew-blueprint-icon {
    width: 72px;
    height: 72px;
    flex-shrink: 0;
    margin-right: 14px;
}

.brew-blueprint-details {
    flex-grow: 1;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
}

.brew-blueprint-title {
    -unity-font-definition: url("project://database/Assets/Art/PixelArtGUI/Fonts/bitcell_memesbruh03.ttf?fileID=12800000&guid=65378f308d5a3fc428e7292ee3d8095b&type=3#bitcell_memesbruh03");
    color: rgb(255, 255, 255);
    font-size: var(--font-size-body);
    -unity-font-style: bold;
    min-height: 30px;
    margin-bottom: 2px;
}

.brew-blueprint-requirements {
    color: rgba(255, 255, 255, 0.6);
    font-size: var(--font-size-small);
    min-height: 52px;
    white-space: normal;
}

/* ==========================================================================
   SCROLLBAR OVERRIDES (Targeting Unity Base Slider for Brewing Panel)
 ========================================================================== */

/* The main vertical scroller container */
.brew-recipe-scroll .unity-scroller--vertical {
    width: 14px;
    background-color: transparent;
    margin-left: 4px; 
}

/* Hide the default Unity up/down arrow buttons */
.brew-recipe-scroll .unity-scroller__low-button,
.brew-recipe-scroll .unity-scroller__high-button {
    display: none;
}

/* Kill the residual gray background on the slider container */
.brew-recipe-scroll .unity-scroller--vertical .unity-slider {
    margin: 0;
    background-color: transparent;
}

/* The background track (Amethyst base background) */
.brew-recipe-scroll .unity-scroller--vertical .unity-base-slider__tracker {
    background-color: rgba(26, 10, 46, 0.6);
    border-color: rgba(212, 160, 23, 0.3);
    border-width: 1px;
    border-radius: 4px;
}

/* The draggable thumb (Golden from highlights) */
.brew-recipe-scroll .unity-scroller--vertical .unity-base-slider__dragger {
    background-color: rgb(212, 160, 23);
    border-color: rgb(255, 220, 100);
    border-width: 1px;
    border-radius: 4px;
    width: 10px; 
    
    left: auto;
    right: auto;
    margin-left: 0;
    margin-right: 0;
    align-self: center; 
}

/* Draggable thumb hover state (Bright Gold) */
.brew-recipe-scroll .unity-scroller--vertical .unity-base-slider__dragger:hover {
    background-color: rgb(255, 220, 100);
}




