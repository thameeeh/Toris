.ability-slot {
    width: 64px;
    height: 64px;
    background-color: rgba(15, 15, 15, 0.8);
    border-width: 2px;
    border-color: var(--color-border-default);
    border-radius: 8px;
    margin: 12px 5px 12px 5px; /* Added top and bottom margin to accommodate overflowing labels */
    overflow: visible;
    justify-content: center;
    align-items: center;
    transition-property: scale, border-color;
    transition-duration: 0.1s;
}

.ability-slot-content {
    width: 100%;
    height: 100%;
    border-radius: 6px; /* Slightly smaller to fit inside border */
    overflow: hidden;
    position: absolute;
}

.ability-slot--pressed {
    scale: 0.9;
    border-color: var(--color-border-highlight);
}

.ability-icon {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

.ability-cooldown-overlay {
    position: absolute;
    bottom: 0;
    width: 100%;
    background-color: rgba(0, 0, 0, 0.7);
    pointer-events: none;
}

.ability-cooldown-timer {
    -unity-font-definition: url("project://database/Assets/Art/PixelArtGUI/Fonts/bitcell_memesbruh03.ttf?fileID=12800000&guid=65378f308d5a3fc428e7292ee3d8095b&type=3#bitcell_memesbruh03");
    position: absolute;
    width: 100%;
    height: 100%;
    -unity-text-align: middle-center;
    color: var(--color-text-light);
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: var(--color-text-outline);
    pointer-events: none;
}

.ability-slot--ready {
    border-color: var(--color-border-highlight);
}

.ability-mana-cost {
    -unity-font-definition: url("project://database/Assets/Art/PixelArtGUI/Fonts/bitcell_memesbruh03.ttf?fileID=12800000&guid=65378f308d5a3fc428e7292ee3d8095b&type=3#bitcell_memesbruh03");
    position: absolute;
    bottom: -12px;
    color: white;
    font-size: 16px;
    -unity-font-style: bold;
    background-color: rgba(0, 0, 0, 0.8);
    padding: 1px 4px;
    border-radius: 4px;
    border-width: 1px;
    border-color: var(--color-border-highlight);
    -unity-text-outline-width: 0.5px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.8);
    pointer-events: none;
}
