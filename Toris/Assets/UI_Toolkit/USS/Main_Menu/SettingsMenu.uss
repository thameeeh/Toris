/* The wrapper that fills the TemplateContainer */
.settings-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    flex-direction: row;
    justify-content: flex-end; /* Pushes the child panel to the far right */
    picking-mode: Ignore; /* Lets clicks pass through the invisible left side */
}

/* The visible right-side panel */
.settings-panel {
    width: 65%; /* Takes up roughly the right two-thirds of the screen */
    height: 100%;
    
    /* Using your established theme variables */
    background-color: var(--color-bg-dark); 
    border-left-width: 2px;
    border-left-color: var(--color-border-default);
    
    padding: 60px;
    flex-direction: column;
    picking-mode: Position; /* Catches clicks so they don't hit the main menu underneath */
}

.settings-title {
    margin-bottom: 40px;
}

.settings-content {
    flex-grow: 1; /* Fills all available vertical space, pushing the close button down */
    flex-direction: column;
    margin-bottom: 20px;
}

/* --- Added Slider Styles --- */
.settings-section-header {
    -unity-font-definition: url("project://database/Assets/Art/PixelArtGUI/Fonts/bitcell_memesbruh03.ttf?fileID=12800000&guid=65378f308d5a3fc428e7292ee3d8095b&type=3#bitcell_memesbruh03");
    font-size: 24px;
    -unity-font-style: bold;
    color: var(--color-border-highlight);
    margin-bottom: 15px;
    border-bottom-width: 1px;
    border-bottom-color: var(--color-border-default);
    padding-bottom: 5px;
}

.settings-section-spacing {
    margin-top: 40px;
}

.settings-slider-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 15px;
    padding-right: 20%; /* Keep sliders from hitting the very edge */
}

.settings-slider {
    width: 250px;
}

.settings-dropdown {
    width: 250px;
    font-size: var(--font-size-small);
}

.settings-action-row {
    flex-direction: row;
    justify-content: flex-end;
    padding-right: 20%;
    margin-bottom: 15px;
}

.settings-apply-button {
    width: 250px;
    height: 44px;
    font-size: var(--font-size-small);
}

.settings-confirmation-overlay {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    background-color: rgba(0, 0, 0, 0.82);
    justify-content: center;
    align-items: center;
    picking-mode: Position;
}

.settings-confirmation-panel {
    width: 460px;
    min-height: 220px;
    background-color: var(--color-bg-dark);
    border-width: 2px;
    border-color: var(--color-border-highlight);
    padding: 28px;
    align-items: center;
}

.settings-confirmation-title {
    -unity-font-definition: url("project://database/Assets/Art/PixelArtGUI/Fonts/bitcell_memesbruh03.ttf?fileID=12800000&guid=65378f308d5a3fc428e7292ee3d8095b&type=3#bitcell_memesbruh03");
    color: var(--color-text-light);
    font-size: var(--font-size-h3);
    -unity-text-align: middle-center;
    margin-bottom: 18px;
}

.settings-confirmation-message {
    color: var(--color-text-light);
    font-size: var(--font-size-body);
    white-space: normal;
    -unity-text-align: middle-center;
    margin-bottom: 24px;
}

.settings-confirmation-buttons {
    flex-direction: row;
    justify-content: space-between;
    width: 100%;
}

.settings-confirmation-button {
    width: 46%;
    height: 46px;
    font-size: var(--font-size-small);
}

/* -------------------------- */

.settings-close-button {
    -unity-font-definition: url("project://database/Assets/Art/PixelArtGUI/Fonts/bitcell_memesbruh03.ttf?fileID=12800000&guid=65378f308d5a3fc428e7292ee3d8095b&type=3#bitcell_memesbruh03");
    height: 60px;
    width: 250px;
    align-self: flex-end; /* Aligns the button to the bottom right corner */
    font-size: var(--font-size-body);
}
