.prologue-story {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-color: rgb(3, 4, 6);
}

.prologue-story__card-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
}

.prologue-story__background {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
    background-color: rgb(9, 12, 16);
}

.prologue-story__dimmer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.58);
}

.prologue-story__content {
    position: absolute;
    left: 8%;
    right: 8%;
    bottom: 9%;
    max-width: 1100px;
    flex-direction: column;
    padding-left: 32px;
    padding-right: 32px;
    padding-top: 25px;
    padding-bottom: 25px;
    border-left-width: 3px;
    border-left-color: rgb(226, 190, 108);
    background-color: rgba(7, 8, 10, 0.76);
}

.prologue-story__title {
    color: rgb(247, 232, 197);
    font-size: 48px;
    -unity-font-style: bold;
    margin-bottom: 14px;
    white-space: normal;
}

.prologue-story__body {
    color: rgb(229, 222, 209);
    font-size: 28px;
    white-space: normal;
    margin-bottom: 23px;
}

.prologue-story__prompt {
    align-self: flex-end;
    flex-direction: row;
    align-items: center;
    min-height: 51px;
}

.prologue-story__prompt-text {
    color: rgb(247, 232, 197);
    font-size: 23px;
    -unity-font-style: bold;
    margin-right: 14px;
}

.prologue-story__keycap {
    align-self: flex-end;
    min-width: 138px;
    height: 51px;
    padding-left: 21px;
    padding-right: 21px;
    border-width: 2px;
    border-color: rgba(247, 232, 197, 0.82);
    border-radius: 4px;
    color: rgb(247, 232, 197);
    background-color: rgba(0, 0, 0, 0.34);
    font-size: 21px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.prologue-tutorial-prompt {
    position: absolute;
    min-width: 194px;
    max-width: 414px;
    min-height: 48px;
    padding-left: 21px;
    padding-right: 21px;
    padding-top: 9px;
    padding-bottom: 9px;
    border-width: 2px;
    border-color: rgba(247, 232, 197, 0.82);
    border-radius: 4px;
    background-color: rgba(5, 6, 8, 0.82);
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.prologue-tutorial-prompt__label {
    color: rgb(247, 232, 197);
    font-size: 25px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

.prologue-tutorial-prompt__continue {
    margin-top: 12px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.prologue-tutorial-prompt__continue-text {
    margin-right: 9px;
    color: rgb(217, 207, 185);
    font-size: 18px;
    -unity-font-style: bold;
}

.prologue-tutorial-prompt__keycap {
    min-width: 67px;
    height: 31px;
    padding-left: 9px;
    padding-right: 9px;
    border-width: 1px;
    border-color: rgba(247, 232, 197, 0.82);
    border-radius: 3px;
    color: rgb(247, 232, 197);
    background-color: rgba(0, 0, 0, 0.34);
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
