.skill-screen__root {
    flex-grow: 1;
    background-color: rgb(30, 30, 35);
    flex-direction: row;
}

/* --- LEFT SIDE: SELECTION & TABS --- */
.skill-selection-panel {
    flex-grow: 1;
    width: 65%;
    background-color: rgb(25, 25, 30);
    padding: 20px;
}

.tabs-container {
    flex-direction: row;
    margin-bottom: 20px;
    border-bottom-width: 2px;
    border-color: var(--color-border-default);
}

.tab-button {
    padding: 12px 24px;
    background-color: transparent;
    border-width: 0;
    color: rgb(150, 150, 150);
    font-size: 16px;
    -unity-font-style: bold;
    border-bottom-width: 3px;
    border-color: transparent;
}

.tab-button:hover {
    color: rgb(200, 200, 200);
    background-color: rgba(255, 255, 255, 0.05);
}

.tab-button--active {
    color: var(--color-border-highlight);
    border-color: var(--color-border-highlight);
}

.skill-grid-scrollview {
    flex-grow: 1;
}

.skill-grid-container {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
    padding: 10px;
}

/* --- SKILL NODE (Grid Version) --- */
.skill-node {
    width: 120px;
    height: 120px;
    background-color: rgb(40, 40, 45);
    border-width: 2px;
    border-color: rgb(60, 60, 60);
    margin: 10px;
    border-radius: 8px;
    align-items: center;
    justify-content: center;
    transition-duration: 0.15s;
}

.skill-node:hover {
    scale: 1.05;
    background-color: rgb(50, 50, 55);
    border-color: var(--color-border-highlight);
}

.skill-node__label {
    color: rgb(220, 220, 220);
    font-size: 12px;
    -unity-text-align: middle-center;
    white-space: normal;
    padding: 5px;
    margin-top: 5px;
}

.skill-node--unlocked {
    background-color: rgba(70, 150, 70, 0.3);
    border-color: rgb(100, 255, 100);
}

.skill-node--available {
    background-color: rgba(150, 150, 70, 0.2);
    border-color: rgb(255, 255, 100);
}

.skill-node--locked {
    opacity: 0.5;
    background-color: rgb(20, 20, 20);
}

/* --- RIGHT SIDE: INFO & VIDEO --- */
.skill-info-panel {
    width: 35%;
    height: 100%;
    background-color: var(--color-bg-panel);
    border-left-width: 2px;
    border-color: var(--color-border-default);
    padding: 20px;
}

.video-preview-container {
    width: 100%;
    aspect-ratio: 1.77; /* 16:9 */
    background-color: black;
    border-width: 2px;
    border-color: var(--color-border-default);
    margin-bottom: 20px;
    align-items: center;
    justify-content: center;
}

.video-placeholder-label {
    color: rgb(100, 100, 100);
    font-size: 18px;
    -unity-font-style: bold;
}

.skill-info-panel__content {
    flex-grow: 1;
}

.skill-info-panel__footer {
    border-top-width: 1px;
    border-color: var(--color-border-default);
    padding-top: 20px;
}

/* --- TYPOGRAPHY --- */
.info-text-h2 {
    font-size: var(--font-size-h2);
    color: var(--color-text-light);
    -unity-font-style: bold;
    margin-bottom: 10px;
}

.info-text-h3 {
    font-size: var(--font-size-h3);
    color: var(--color-border-highlight);
    margin-bottom: 15px;
}

.info-text-body {
    font-size: var(--font-size-body);
    color: rgb(200, 200, 200);
    margin-bottom: 15px;
}

.skill-unlock-btn {
    height: 50px;
    font-size: 16px;
    -unity-font-style: bold;
    background-color: rgb(45, 75, 45);
    border-color: rgb(100, 200, 100);
    border-width: 2px;
    border-radius: 8px;
    color: white;
}

.skill-unlock-btn:hover {
    background-color: rgb(60, 100, 60);
}

.skill-unlock-btn:disabled {
    opacity: 0.5;
    background-color: rgb(40, 40, 40);
    border-color: rgb(60, 60, 60);
}
