.death-screen-host {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
}

.death-screen {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: rgba(4, 0, 0, 0.72);
}

.death-screen__panel {
    min-width: 560px;
    max-width: 980px;
    width: 68%;
    min-height: 640px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding-left: 64px;
    padding-right: 64px;
    padding-top: 56px;
    padding-bottom: 52px;
    border-width: 2px;
    border-color: rgba(196, 44, 44, 0.9);
    border-radius: 6px;
    background-color: rgba(13, 7, 7, 0.9);
}

.death-screen__header {
    align-items: center;
    margin-bottom: 26px;
}

.death-screen__title {
    -unity-font-definition: url("project://database/Assets/Art/PixelArtGUI/Fonts/bitcell_memesbruh03.ttf?fileID=12800000&guid=65378f308d5a3fc428e7292ee3d8095b&type=3#bitcell_memesbruh03");
    color: rgb(238, 233, 221);
    font-size: 76px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-color: rgba(112, 14, 14, 0.85);
    -unity-text-outline-width: 1px;
}

.death-screen__subtitle {
    color: rgba(222, 173, 151, 0.92);
    font-size: 22px;
    -unity-text-align: middle-center;
    margin-top: 6px;
}

.death-screen__summary {
    width: 100%;
    max-width: 720px;
    flex-direction: column;
    padding-left: 22px;
    padding-right: 22px;
    padding-top: 18px;
    padding-bottom: 18px;
    margin-bottom: 32px;
    border-width: 1px;
    border-color: rgba(238, 233, 221, 0.2);
    border-radius: 4px;
    background-color: rgba(0, 0, 0, 0.3);
}

.death-screen__summary-title {
    -unity-font-definition: url("project://database/Assets/Art/PixelArtGUI/Fonts/bitcell_memesbruh03.ttf?fileID=12800000&guid=65378f308d5a3fc428e7292ee3d8095b&type=3#bitcell_memesbruh03");
    color: rgb(238, 213, 171);
    font-size: 32px;
    -unity-font-style: bold;
    margin-bottom: 12px;
}

.death-screen__metric-rows {
    flex-direction: column;
    margin-bottom: 14px;
}

.death-screen__metric-row {
    min-height: 40px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    border-bottom-width: 1px;
    border-bottom-color: rgba(238, 233, 221, 0.1);
}

.death-screen__metric-label {
    color: rgba(238, 233, 221, 0.74);
    font-size: 23px;
}

.death-screen__metric-value {
    -unity-font-definition: url("project://database/Assets/Art/PixelArtGUI/Fonts/bitcell_memesbruh03.ttf?fileID=12800000&guid=65378f308d5a3fc428e7292ee3d8095b&type=3#bitcell_memesbruh03");
    color: rgb(240, 226, 200);
    font-size: 25px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
}

.death-screen__items-title {
    -unity-font-definition: url("project://database/Assets/Art/PixelArtGUI/Fonts/bitcell_memesbruh03.ttf?fileID=12800000&guid=65378f308d5a3fc428e7292ee3d8095b&type=3#bitcell_memesbruh03");
    color: rgba(238, 213, 171, 0.94);
    font-size: 24px;
    -unity-font-style: bold;
    margin-top: 2px;
    margin-bottom: 8px;
}

.death-screen__item-scroll {
    min-height: 200px;
    max-height: 240px;
    border-width: 1px;
    border-color: rgba(238, 233, 221, 0.08);
    background-color: rgba(0, 0, 0, 0.18);
}

.death-screen__item-list {
    flex-direction: row;
    flex-wrap: wrap;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 8px;
    padding-bottom: 8px;
}

.death-screen__item-card {
    width: 62px;
    height: 62px;
    margin-left: 4px;
    margin-right: 4px;
    margin-top: 4px;
    margin-bottom: 4px;
    border-width: 1px;
    border-color: rgba(238, 233, 221, 0.18);
    background-color: rgba(12, 10, 9, 0.7);
}

.death-screen__item-card:hover {
    border-color: rgba(238, 213, 171, 0.78);
    background-color: rgba(30, 19, 18, 0.82);
}

.death-screen__item-card--potion {
    border-color: rgba(94, 159, 220, 0.52);
}

.death-screen__item-card--backpack {
    border-color: rgba(238, 213, 171, 0.28);
}

.death-screen__item-card-icon {
    width: 76%;
    height: 76%;
    margin: auto;
}

.death-screen__item-card-count {
    position: absolute;
    right: 4px;
    bottom: 2px;
    color: rgb(238, 233, 221);
    font-size: 17px;
    -unity-font-style: bold;
    -unity-text-outline-color: rgba(0, 0, 0, 0.92);
    -unity-text-outline-width: 1px;
}

.death-screen__item-row {
    min-height: 32px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.death-screen__item-name {
    color: rgba(238, 233, 221, 0.9);
    font-size: 22px;
    flex-grow: 1;
}

.death-screen__item-source {
    color: rgba(222, 173, 151, 0.78);
    font-size: 19px;
    -unity-text-align: middle-right;
    min-width: 86px;
}

.death-screen__item-message {
    color: rgba(238, 233, 221, 0.72);
    font-size: 23px;
}

.death-screen__actions {
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.death-screen__button {
    -unity-font-definition: url("project://database/Assets/Art/PixelArtGUI/Fonts/bitcell_memesbruh03.ttf?fileID=12800000&guid=65378f308d5a3fc428e7292ee3d8095b&type=3#bitcell_memesbruh03");
    min-width: 220px;
    height: 64px;
    font-size: 22px;
    -unity-font-style: bold;
    margin-left: 10px;
    margin-right: 10px;
}

.death-screen__button--primary {
    border-color: rgb(210, 42, 42);
}
